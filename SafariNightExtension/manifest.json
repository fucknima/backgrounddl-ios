{
  "manifest_version": 3,
  "name": "智夜 · Dark Reader",
  "short_name": "智夜",
  "version": "2.1.0",
  "description": "开源 Dark Reader 动态主题：修复自动误判，搜狗专属白屏样式补救，新增扩展注入状态检测。",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "智夜 · Dark Reader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "css": [
        "prepaint.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://m.sogou.com/*",
        "*://*.m.sogou.com/*"
      ],
      "css": [
        "sogou-fix.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
